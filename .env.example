# KAMIS OpenAPI 인증키/ID (https://www.kamis.or.kr) — 야채 시세 프로토타입 실호출용. 없으면 더미로 폴백.
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# Kakao REST 키 — 역지오코딩(동 판별)·장소 검색·OAuth code 교환용. 서버 전용(BFF에서만 사용).
KAKAO_REST_KEY=

# Kakao Login 클라이언트 시크릿 — 이 앱은 활성화를 필수 운영 정책으로 사용한다. 서버 전용.
KAKAO_CLIENT_SECRET=

# Kakao Login 콜백. 카카오디벨로퍼스에 등록한 값과 한 글자까지 같아야 한다.
# 로컬 예시: http://localhost:3000/api/auth/kakao/callback
KAKAO_REDIRECT_URI=

# Kakao JavaScript 앱키 — 가게 상세 지도 렌더링용(브라우저에서 SDK를 부른다).
# 도메인 제한이 걸리는 공개 키라 NEXT_PUBLIC_ 노출이 정상이다(시크릿 아님).
# 미설정 시 지도 캔버스 없이 주소·거리만 표시된다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# 외부 Spring(marketgo) base URL — 서버 전용. 스펙: https://api.marketgo.kro.kr/v3/api-docs
# 스펙의 servers[0]은 http로 잡혀 있으나 https를 쓴다(리다이렉트·혼합 콘텐츠 방지).
# 미설정 시 운영 주소로 폴백한다.
SPRING_API_BASE_URL=https://api.marketgo.kro.kr

# Spring outbound 요청 구조화 로그. 로컬 개발은 미설정 시 자동 활성화된다.
# Vercel Preview에서 확인할 때만 true로 설정한다. Vercel Production은 항상 비활성화된다.
# false로 설정하면 로컬에서도 비활성화된다. 토큰·쿠키·응답 값은 기록하지 않는다.
SPRING_API_DEBUG=
